# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
firestore-debug.log
**/firestore-debug.log

# Stripe and Functions runtime configuration.
# Secrets themselves live in Secret Manager (firebase functions:secrets:set),
# never in a file. Only functions/.env.example is committed.
functions/.env
functions/.env.*
!functions/.env.example
