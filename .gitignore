# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
**/__pycache__/
*.py[cod]

# production
/build
/.vercel
/.firebase
/.runtimeconfig.json
/.firebase-emulator-data
/firebase-export

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production configuration is supplied by Vercel/Secret Manager. Commit only
# the placeholder examples; never a populated environment file.
.env.production

npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
**/firebase-debug.log*
firestore-debug.log
**/firestore-debug.log
**/firebase-export
**/.firebase-emulator-data

# Stripe and Functions runtime configuration.
# Secrets themselves live in Secret Manager (firebase functions:secrets:set),
# never in a file. Only functions/.env.example is committed.
functions/.env
functions/.env.*
!functions/.env.example
!functions/.env.local.example
!functions/.env.production.example
functions/.secret.local
functions/.secret.*
