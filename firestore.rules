rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return isSignedIn() && exists(currentUserPath());
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    // Access is always resolved from the authoritative Firestore document.
    // Custom claims are deliberately not an allow path: a stale positive claim
    // must never delay a ban, dispute suspension, or membership revocation.
    function hasStaffEntitlement() {
      return (
        currentUser().role == "admin" ||
        currentUser().role == "sgpt"
      ) &&
        currentUser().entitlementStatus == "active" &&
        currentUser().entitlementSource == "staff";
    }

    function hasMemberEntitlement() {
      return currentUser().role == "user" &&
        currentUser().entitlementStatus == "active" &&
        (
          currentUser().entitlementSource == "legacy" ||
          currentUser().entitlementSource == "manual" ||
          currentUser().entitlementSource == "stripe"
        );
    }

    function hasAlphaWodAccess() {
      return currentUserExists() &&
        currentUser().approvalStatus == "approved" &&
        currentUser().alphaWodAccess == true &&
        (hasStaffEntitlement() || hasMemberEntitlement());
    }

    function isAdmin() {
      return hasAlphaWodAccess() && currentUser().role == "admin";
    }

    function isSgpt() {
      return hasAlphaWodAccess() && currentUser().role == "sgpt";
    }

    function hasPerformanceAccess() {
      return isAdmin() || isSgpt();
    }

    function affectsOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isNullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidPhotoUrl(value) {
      return value == null || (
        value is string &&
        value.size() <= 2048 &&
        value.matches("^https://.*$")
      );
    }

    function isHarmlessProfileUpdate() {
      return affectsOnly(["name", "photoURL", "updatedAt"]) &&
        isNullableString(request.resource.data.get("name", null), 120) &&
        isValidPhotoUrl(request.resource.data.get("photoURL", null)) &&
        request.resource.data.get("updatedAt", null) == request.time;
    }

    function isValidTrainingLog(log, userId) {
      return log.keys().hasAll([
          "userId",
          "category",
          "movementSlug",
          "movementName",
          "metricType",
          "value",
          "unit",
          "reps",
          "date",
          "notes",
          "createdAt"
        ]) &&
        log.keys().hasOnly([
          "userId",
          "category",
          "movementSlug",
          "movementName",
          "metricType",
          "value",
          "unit",
          "reps",
          "date",
          "notes",
          "createdAt"
        ]) &&
        log.userId == userId &&
        log.category is string && log.category.size() <= 80 &&
        log.movementSlug is string && log.movementSlug.size() <= 120 &&
        log.movementName is string && log.movementName.size() <= 160 &&
        log.metricType is string && log.metricType.size() <= 80 &&
        log.value is string && log.value.size() <= 80 &&
        log.unit is string && log.unit.size() <= 40 &&
        log.reps is string && log.reps.size() <= 40 &&
        log.date is string && log.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
        log.notes is string && log.notes.size() <= 2000 &&
        log.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwnUser(userId) || isAdmin();
      allow list: if isAdmin();

      // Account bootstrap and every access/role/entitlement field are owned by
      // trusted Cloud Functions. Admin SDK writes bypass these client rules.
      allow create, delete: if false;
      allow update: if isOwnUser(userId) && isHarmlessProfileUpdate();

      match /trainingLogs/{logId} {
        allow read: if hasPerformanceAccess() ||
          (isOwnUser(userId) && hasAlphaWodAccess());

        allow create: if isOwnUser(userId) &&
          hasAlphaWodAccess() &&
          isValidTrainingLog(request.resource.data, userId) &&
          request.resource.data.createdAt == request.time;

        allow update: if isOwnUser(userId) &&
          hasAlphaWodAccess() &&
          isValidTrainingLog(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isOwnUser(userId) &&
          hasAlphaWodAccess() &&
          resource.data.userId == userId;
      }
    }

    // Immutable, detailed signature evidence. This collection is server-only;
    // a callable may return a deliberately shaped durable copy when required.
    match /waiverAcceptances/{acceptanceId} {
      allow read, write: if false;
    }

    // Collection-group reads are staff-only. Owner reads are granted only by
    // the concrete users/{uid}/trainingLogs rule above.
    match /{path=**}/trainingLogs/{logId} {
      allow read: if hasPerformanceAccess();
      allow write: if false;
    }

    match /appSettings/{settingsId} {
      allow read: if hasAlphaWodAccess();
      allow write: if false;
    }

    match /wods/{wodDate} {
      allow read: if hasAlphaWodAccess();
      allow write: if isAdmin();
    }

    match /wodTemplates/{templateId} {
      allow read: if hasAlphaWodAccess();
      allow write: if isAdmin();
    }

    match /classTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if hasAlphaWodAccess();
      // Occurrences and bookedCount are maintained transactionally by trusted
      // Cloud Functions; clients must not forge capacity or attendance state.
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (
        hasAlphaWodAccess() && resource.data.userId == request.auth.uid
      );
      // Booking lifecycle is server-only so capacity and attendance invariants
      // cannot be bypassed with direct SDK writes.
      allow write: if false;
    }

    // Precomputed monthly leaderboard summary, written by Cloud Functions.
    match /leaderboards/{monthKey} {
      // Stored rows can lag a revocation, so member-visible results are shaped
      // by a callable that rechecks every referenced profile authoritatively.
      allow read, write: if false;
    }

    // Billing state is server-only.
    //
    // These documents hold participant and guardian personal data, signature
    // evidence, and payment status. Members reach their own membership through
    // a callable projection that reshapes it, so no client read path exists
    // here, and no client may forge a membership, an entitlement source, or a
    // webhook ledger entry.
    match /memberships/{subscriptionId} {
      allow read, write: if false;
    }

    // Pending checkout details, written before the customer reaches Stripe and
    // consumed by the fulfilment webhook.
    match /membershipIntents/{intentId} {
      allow read, write: if false;
    }

    // Deterministic, expiring uniqueness reservations used while Stripe
    // Checkout is in flight. Client access would let an attacker suppress or
    // bypass the duplicate-membership guard.
    match /membershipCheckoutLocks/{lockId} {
      allow read, write: if false;
    }

    // One durable owner per AlphaWOD entitlement target. Claims, fulfilment,
    // and admin links contend on this server-owned record atomically.
    match /membershipEntitlementOwners/{ownerId} {
      allow read, write: if false;
    }

    // Webhook idempotency ledger. A client write here could suppress or replay
    // a fulfilment event.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Immutable confirmation payloads and retry state. Exposing this would
    // leak billing email/details and let a client suppress the durable copy.
    match /membershipEmailOutbox/{messageId} {
      allow read, write: if false;
    }

    match /membershipAudit/{entryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
