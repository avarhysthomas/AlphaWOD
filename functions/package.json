{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "test:emulator": "npm run build && firebase emulators:exec --config ../firebase.json --project alpha-wod-functions-test --only auth,firestore \"node --test --test-concurrency=1 test-emulator/*.test.js\"",
    "verify:stripe-test-config": "npm run build && node --env-file=.env.local scripts/verifyStripeTestConfig.js",
    "verify:stripe-test-journey": "npm run build && node --env-file=.env.local scripts/verifyStripeTestJourney.js",
    "verify:production-config": "npm run build && node --env-file-if-exists=.env.production scripts/verifyProductionConfig.js",
    "verify:stripe-live-config": "npm run build && node --env-file-if-exists=.env.production scripts/verifyStripeLiveConfig.js",
    "run:stripe-test-journey": "npm run build && node scripts/runLocalStripeTestJourney.js",
    "build:watch": "tsc --watch",
    "backfill:claims": "npm run build && node scripts/backfillClaims.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "node -e \"console.error('Blocked: follow docs/billing/phase-1-rollout.md and selectively deploy reviewed functions.'); process.exit(1)\"",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "luxon": "^3.7.2",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
