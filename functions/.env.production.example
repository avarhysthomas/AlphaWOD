# Production Functions parameters only. Copy this template to the exact
# git-ignored Firebase CLI project file before filling it:
#   cp functions/.env.production.example functions/.env.alphawod-d1f2f
# Placeholder values are deliberately rejected.
#
# Do not put secrets in this file. Set STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, RESEND_API_KEY,
# MEMBERSHIP_CHECKOUT_RATE_LIMIT_SECRET, PAYG_CANCELLATION_TOKEN_SECRET,
# PAYG_CANCELLATION_TOKEN_PREVIOUS_SECRET, PAYG_CHECKOUT_RATE_LIMIT_SECRET,
# PAYG_DUPLICATE_LOCK_SECRET and PAYG_DUPLICATE_LOCK_PREVIOUS_SECRET
# through Firebase Secret Manager.

APP_PUBLIC_ORIGIN=https://alpha-wod.vercel.app

# All purchase gates stay closed during configuration and deployment. Opening
# is the final, separately authorised rollout step after legal publication,
# staging evidence, alerts and the live smoke test are complete.
MEMBERSHIP_PURCHASE_ENABLED=false
ADULT_CONDITIONING_PURCHASE_ENABLED=false
ADULT_CONDITIONING_LEGAL_APPROVED=false
MEMBERSHIP_TEST_JOURNEY_ENABLED=false

MEMBERSHIP_FIREBASE_PROJECT_ID=alphawod-d1f2f
# Must exactly match REACT_APP_FIREBASE_APP_ID in the authorised production
# web build. Checkout rejects App Check tokens from other apps in the project.
MEMBERSHIP_CHECKOUT_APP_ID=replace_with_production_firebase_web_app_id
STRIPE_EXPECTED_MODE=live

STRIPE_PORTAL_CONFIGURATION_ID=replace_with_live_portal_configuration_id
# Exact LIVE Price IDs from the 17 August 2026 Stripe exports, independently
# re-read from the live API on 19 August 2026. Their Product bindings are frozen
# in src/stripeLiveCatalog.ts and rechecked before Checkout.
STRIPE_PRICE_ADULT_UNLIMITED=price_1U5KgYFzNDZoGGA0jGftxyZH
STRIPE_PRICE_ADULT_CONDITIONING=price_1UA3T0FzNDZoGGA0RJg5qEHe
STRIPE_PRICE_ADULT_LADIES=price_1U5KjOFzNDZoGGA0j3qcds5p
STRIPE_PRICE_ADULT_GYM=price_1U5Kk9FzNDZoGGA0dQ61G49d
STRIPE_PRICE_YOUTH_YOUNGSTARS=price_1U5KoQFzNDZoGGA0s4t806bH
STRIPE_PRICE_YOUTH_TEENSTARS=price_1U5Kt8FzNDZoGGA0ogq41DEw

# One-time PAYG uses a separate checkout domain and separate rollout gates.
STRIPE_PRICE_ADULT_PAYG_CLASS=price_1UA3TdFzNDZoGGA0dCgYfU2h

# PAYG is independently gated. Leave both false until dedicated documents are
# approved/published and the live one-time Checkout has passed preflight.
PAYG_AVAILABILITY_ENABLED=false
PAYG_LEGAL_APPROVED=false
PAYG_FIREBASE_PROJECT_ID=alphawod-d1f2f
PAYG_PRODUCT_TAX_CODE=txcd_50021001
PAYG_WAIVER_VERSION=replace_with_approved_payg_waiver_version
PAYG_WAIVER_PUBLIC_URL=replace_with_approved_payg_waiver_public_url
PAYG_WAIVER_SHA256=replace_with_approved_payg_waiver_sha256
PAYG_TERMS_VERSION=replace_with_approved_payg_terms_version
PAYG_TERMS_PUBLIC_URL=replace_with_approved_payg_terms_public_url
PAYG_TERMS_SHA256=replace_with_approved_payg_terms_sha256
# No PAYG purchase may open until the owner/legal team approves exact redaction
# semantics and the code-level launch blocker is replaced by reviewed workers.
PAYG_PII_REDACTION_IMPLEMENTED=true
PAYG_PII_RETENTION_APPROVED=false
PAYG_PII_RETENTION_POLICY_VERSION=
PAYG_ORDER_PII_RETENTION_DAYS=
PAYG_WAIVER_PII_RETENTION_DAYS=
PAYG_CANCELLATION_TOKEN_KEY_ID=cancel-v1
PAYG_CANCELLATION_TOKEN_PREVIOUS_KEY_ID=
PAYG_CANCELLATION_TOKEN_PREVIOUS_VALID_UNTIL=
PAYG_DUPLICATE_LOCK_KEY_ID=lock-v1
PAYG_DUPLICATE_LOCK_PREVIOUS_KEY_ID=
PAYG_DUPLICATE_LOCK_PREVIOUS_VALID_UNTIL=
PAYG_FROM_EMAIL=Zero Alpha Fitness <hello@zeroalphafitness.co.uk>
PAYG_REPLY_TO_EMAIL=support@zeroalphafitness.co.uk

# Separate LIVE objects for the one shared existing-member offer. Never copy
# the sandbox Coupon or Promotion Code IDs into this file.
STRIPE_EXISTING_MEMBER_COUPON_ID=replace_with_live_coupon_id
STRIPE_EXISTING_MEMBER_PROMOTION_CODE_ID=replace_with_live_promotion_code_id
STRIPE_YOUTH_FAMILY_COUPON_ID=zaf_youth_family_15pct_2026

MEMBERSHIP_FROM_EMAIL=hello@zeroalphafitness.co.uk

# Secret Manager must also contain distinct random 32+ byte
# MEMBERSHIP_CHECKOUT_RATE_LIMIT_SECRET, PAYG_CANCELLATION_TOKEN_SECRET,
# PAYG_CHECKOUT_RATE_LIMIT_SECRET and PAYG_DUPLICATE_LOCK_SECRET values. During
# a reviewed rotation, also bind the matching previous secret until the
# configured overlap horizon. Never place any of them in a dotenv file.
