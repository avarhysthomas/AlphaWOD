# Cloud Functions runtime configuration for the Phase 1 membership flow.
#
# Copy to functions/.env (git-ignored) and fill in per environment.
# SECRETS ARE NOT SET HERE. STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are
# stored in Secret Manager:
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set PAYG_CANCELLATION_TOKEN_SECRET
#   firebase functions:secrets:set PAYG_CHECKOUT_RATE_LIMIT_SECRET
#   firebase functions:secrets:set PAYG_DUPLICATE_LOCK_SECRET

# Public origin used to build Stripe return URLs. Must be the real app origin;
# it is the only origin accepted for checkout success and cancel redirects.
APP_PUBLIC_ORIGIN=https://alpha-wod.vercel.app

# Master switch for the public purchase flow. Purchase also requires
# CHECKOUT_DOCUMENTS_APPROVED_FOR_PUBLICATION to be true in
# functions/src/membershipPlans.ts. The 23 August 2026 bundle is approved;
# this separate runtime switch remains closed until an authorised release.
MEMBERSHIP_PURCHASE_ENABLED=false

# Conditioning has a second rollout boundary because the currently published
# membership terms predate this plan. Keep both false outside an isolated test.
ADULT_CONDITIONING_PURCHASE_ENABLED=false
ADULT_CONDITIONING_LEGAL_APPROVED=false

# Explicit Firebase/Stripe boundary. Billing refuses every provider call when
# either value is missing or does not match the actual runtime/key/object mode.
# Use the real Firebase project id in each deployed environment. For the local
# journey use the demo namespace shown here; test mode is hard-blocked on the
# production project `alphawod-d1f2f`.
MEMBERSHIP_FIREBASE_PROJECT_ID=
STRIPE_EXPECTED_MODE=

# Local-emulator escape hatch for a real Stripe TEST payment. It additionally
# requires test mode, a test or restricted-test key, the exact non-production
# project above, both Auth and Firestore emulators, and one of the explicitly
# approved localhost origins (ports 3000 or 3002). It cannot run in a deployed
# Function or open the production purchase flow.
MEMBERSHIP_TEST_JOURNEY_ENABLED=false

# ---------------------------------------------------------------------------
# TEST MODE vs LIVE MODE
#
# Everything below is mode-specific and NONE of it carries across:
#   - products and prices
#   - the Customer Portal configuration
#   - the webhook endpoint and its signing secret
#   - the secret key itself (sk_test_... vs sk_live_...)
#
# The live catalogue has to be created separately in the Stripe Dashboard in
# live mode, which produces a different set of price IDs.
# ---------------------------------------------------------------------------

# Stripe Billing Customer Portal configuration ID, "bpc_..." (mode-specific).
#
# The referenced configuration MUST have subscription_cancel disabled. The
# approved policy routes cancellation through the in-app request flow so the
# 14-day notice rule is applied and the receipt time is recorded; Stripe's own
# cancel button would bypass both.
#
# Scope should be exactly what the policy promises: invoice history and payment
# method updates. Pause is no longer a portal feature in the Stripe API, so
# there is nothing to disable for the no-pause rule.
#
# Create one per mode:
#   curl https://api.stripe.com/v1/billing_portal/configurations \
#     -u "$STRIPE_SECRET_KEY:" \
#     -d "name=AlphaWOD membership portal" \
#     -d "business_profile[headline]=Zero Alpha Fitness membership billing" \
#     -d "features[invoice_history][enabled]=true" \
#     -d "features[payment_method_update][enabled]=true" \
#     -d "features[customer_update][enabled]=false" \
#     -d "features[subscription_cancel][enabled]=false" \
#     -d "features[subscription_update][enabled]=false" 
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1U5sNqFzNDZoGGA0gY8sswiI

# Plan to Stripe price mapping.
#
# The values below were retrieved and verified directly in Stripe TEST MODE on
# 23 August 2026. The earlier `price_1U5K...` values were provider-confirmed as
# live-mode objects and must not be used by this test configuration.
#
# They are NOT valid in live mode. `resolvePriceId` refuses to use any of them
# when the secret key is an sk_live_ key, so a live deployment that still has
# these values fails with a clear message instead of failing in front of a
# paying customer.
STRIPE_PRICE_ADULT_UNLIMITED=price_1U5PS5FzNDZoGGA0rPLiyQ2Q
STRIPE_PRICE_ADULT_CONDITIONING=price_1UA47fFzNDZoGGA0lgyZPUZ9
STRIPE_PRICE_ADULT_LADIES=price_1U5PKZFzNDZoGGA0xsnNcV2m
STRIPE_PRICE_ADULT_GYM=price_1U5PJHFzNDZoGGA0izMSvHP1
STRIPE_PRICE_YOUTH_YOUNGSTARS=price_1U7akwFzNDZoGGA0zOcCZthI
STRIPE_PRICE_YOUTH_TEENSTARS=price_1U5PEwFzNDZoGGA0d24UJaZd

# Separate one-time guest-class Price. PAYG remains fail-closed unless its own
# availability and legal-publication gates are deliberately opened.
STRIPE_PRICE_ADULT_PAYG_CLASS=price_1UA49JFzNDZoGGA0ciTM2OOQ

# Public guest PAYG is a separate one-time purchase domain. Both gates remain
# closed until the dedicated terms/waiver are approved and published.
PAYG_AVAILABILITY_ENABLED=false
PAYG_LEGAL_APPROVED=false
PAYG_FIREBASE_PROJECT_ID=
PAYG_PRODUCT_TAX_CODE=txcd_50021001
PAYG_WAIVER_VERSION=
PAYG_WAIVER_PUBLIC_URL=
PAYG_WAIVER_SHA256=
PAYG_TERMS_VERSION=
PAYG_TERMS_PUBLIC_URL=
PAYG_TERMS_SHA256=
PAYG_PII_REDACTION_IMPLEMENTED=true
PAYG_PII_RETENTION_APPROVED=false
PAYG_PII_RETENTION_POLICY_VERSION=
PAYG_ORDER_PII_RETENTION_DAYS=
PAYG_WAIVER_PII_RETENTION_DAYS=
PAYG_CANCELLATION_TOKEN_KEY_ID=cancel-v1
PAYG_CANCELLATION_TOKEN_PREVIOUS_KEY_ID=
PAYG_CANCELLATION_TOKEN_PREVIOUS_VALID_UNTIL=
PAYG_DUPLICATE_LOCK_KEY_ID=lock-v1
PAYG_DUPLICATE_LOCK_PREVIOUS_KEY_ID=
PAYG_DUPLICATE_LOCK_PREVIOUS_VALID_UNTIL=
PAYG_FROM_EMAIL=Zero Alpha Fitness <hello@zeroalphafitness.co.uk>
PAYG_REPLY_TO_EMAIL=support@zeroalphafitness.co.uk

# PAYG_CANCELLATION_TOKEN_SECRET, PAYG_CHECKOUT_RATE_LIMIT_SECRET and
# PAYG_DUPLICATE_LOCK_SECRET are separate random 32+ byte Secret Manager values.
# Previous secrets are verify-only rotation inputs and must remain bound for the
# configured overlap horizon. Never reuse or place any value in dotenv.

# Required during the existing-member presale campaign. This test-mode Coupon
# is £5 GBP off Adult Unlimited for three months and is restricted to that
# Product. The app resolves the one allowlisted shared Code and passes Stripe
# that exact Promotion Code id; hosted Checkout's unrestricted code field stays
# disabled. Leave both Stripe objects' maximum-redemptions fields unset and
# manually moderate the small campaign. Test and live objects never carry over.
STRIPE_EXISTING_MEMBER_COUPON_ID=zaf_existing_member_5off_3mo_2026_test_v2
STRIPE_EXISTING_MEMBER_PROMOTION_CODE_ID=promo_1U6ThDFzNDZoGGA0OT0EaV8Z
STRIPE_YOUTH_FAMILY_COUPON_ID=zaf_youth_family_15pct_2026_test

# Sender for the durable membership confirmation required by Terms 4.
# The domain must be verified in Resend. RESEND_API_KEY is a secret and is
# already set for member invites.
MEMBERSHIP_FROM_EMAIL=hello@zeroalphafitness.co.uk
