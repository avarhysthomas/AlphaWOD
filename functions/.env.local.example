# Copy to `.env.local` for the real Stripe test journey. The destination is
# git-ignored. This demo-* namespace cannot address deployed Firebase resources.
APP_PUBLIC_ORIGIN=http://localhost:3002
MEMBERSHIP_PURCHASE_ENABLED=true
MEMBERSHIP_TEST_JOURNEY_ENABLED=true
MEMBERSHIP_FIREBASE_PROJECT_ID=demo-alphawod-stripe
STRIPE_EXPECTED_MODE=test

# Test-mode Portal configuration verified on 18 August 2026. It exposes invoice
# history and payment-method updates only; cancellation, pause, plan switching,
# customer edits and hosted login are disabled.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1U5sNqFzNDZoGGA0gY8sswiI

# Stripe sandbox catalogue verified directly on 18 August 2026.
STRIPE_PRICE_ADULT_UNLIMITED=price_1U5PS5FzNDZoGGA0rPLiyQ2Q
STRIPE_PRICE_ADULT_LADIES=price_1U5PKZFzNDZoGGA0xsnNcV2m
STRIPE_PRICE_ADULT_GYM=price_1U5PJHFzNDZoGGA0izMSvHP1
STRIPE_PRICE_YOUTH_YOUNGSTARS=price_1U5PFZFzNDZoGGA06T2ggw4M
STRIPE_PRICE_YOUTH_TEENSTARS=price_1U5PEwFzNDZoGGA0d24UJaZd

# Stripe TEST ONLY. The read-only preflight verifies the Coupon and every
# active Promotion Code before starting the local journey. One test-only code
# currently exists; obtain it from the provider owner and enter it in the
# AlphaWOD registration form rather than publishing it.
STRIPE_EXISTING_MEMBER_COUPON_ID=zaf_existing_member_5off_3mo_2026_test

MEMBERSHIP_FROM_EMAIL=hello@zeroalphafitness.co.uk
