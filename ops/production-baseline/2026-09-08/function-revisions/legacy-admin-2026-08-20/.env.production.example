# Production Functions parameters only. Copy this template to the exact
# git-ignored Firebase CLI project file before filling it:
#   cp functions/.env.production.example functions/.env.alphawod-d1f2f
# Placeholder values are deliberately rejected.
#
# Do not put secrets in this file. Set STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, RESEND_API_KEY and
# MEMBERSHIP_CHECKOUT_RATE_LIMIT_SECRET through Firebase Secret Manager.

APP_PUBLIC_ORIGIN=https://alpha-wod.vercel.app

# Both gates stay closed during configuration and deployment. Opening purchase
# is the final, separately authorised rollout step after legal publication,
# staging evidence, alerts and the live smoke test are complete.
MEMBERSHIP_PURCHASE_ENABLED=false
MEMBERSHIP_TEST_JOURNEY_ENABLED=false

MEMBERSHIP_FIREBASE_PROJECT_ID=alphawod-d1f2f
# Must exactly match REACT_APP_FIREBASE_APP_ID in the authorised production
# web build. Checkout rejects App Check tokens from other apps in the project.
MEMBERSHIP_CHECKOUT_APP_ID=replace_with_production_firebase_web_app_id
STRIPE_EXPECTED_MODE=live

STRIPE_PORTAL_CONFIGURATION_ID=replace_with_live_portal_configuration_id
# Exact LIVE Price IDs from the 17 August 2026 Stripe exports, independently
# re-read from the live API on 19 August 2026. Their Product bindings are frozen
# in src/stripeLiveCatalog.ts and rechecked before Checkout.
STRIPE_PRICE_ADULT_UNLIMITED=price_1U5KgYFzNDZoGGA0jGftxyZH
STRIPE_PRICE_ADULT_LADIES=price_1U5KjOFzNDZoGGA0j3qcds5p
STRIPE_PRICE_ADULT_GYM=price_1U5Kk9FzNDZoGGA0dQ61G49d
STRIPE_PRICE_YOUTH_YOUNGSTARS=price_1U5KoQFzNDZoGGA0s4t806bH
STRIPE_PRICE_YOUTH_TEENSTARS=price_1U5Kt8FzNDZoGGA0ogq41DEw

# Separate LIVE objects for the one shared existing-member offer. Never copy
# the sandbox Coupon or Promotion Code IDs into this file.
STRIPE_EXISTING_MEMBER_COUPON_ID=replace_with_live_coupon_id
STRIPE_EXISTING_MEMBER_PROMOTION_CODE_ID=replace_with_live_promotion_code_id

MEMBERSHIP_FROM_EMAIL=hello@zeroalphafitness.co.uk

# Secret Manager must also contain a random 32+ byte
# MEMBERSHIP_CHECKOUT_RATE_LIMIT_SECRET. Never place it in a dotenv file.
