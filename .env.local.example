# Local development overrides. Copy to .env.local, which is git-ignored.
#
# Points the app at the Firebase emulators instead of the live project, so
# local testing cannot read or write production data.
#
# Run the emulators in the non-resource-owning demo namespace alongside
# `npm start`:
#   firebase emulators:start --project demo-alphawod-stripe --only auth,firestore,functions
#
# Leave this unset (or false) to run against the live project.
REACT_APP_USE_EMULATORS=true

# Keep browser reads, callable URLs and the backend project guard on the same
# isolated namespace. A demo-* id cannot accidentally address deployed Firebase
# resources.
REACT_APP_FIREBASE_PROJECT_ID=demo-alphawod-stripe

# Override every remaining production Firebase identifier too. Auth, Firestore
# and Functions are explicitly connected to emulators; these inert demo values
# ensure an unrelated screen cannot inherit a production bucket/app identity.
REACT_APP_FIREBASE_API_KEY=demo-local-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=demo-alphawod-stripe.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=demo-alphawod-stripe.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:demoalphawodstripe
REACT_APP_FIREBASE_MEASUREMENT_ID=

# The production browser purchase gate is never the local testing bypass.
REACT_APP_MEMBERSHIP_PURCHASE_ENABLED=false

# Separate fail-closed gate for the Conditioning Only plan. Enable only when
# the matching backend gate and plan-specific legal release are configured.
REACT_APP_ADULT_CONDITIONING_PURCHASE_ENABLED=false

# Set true only while following the local Stripe test-journey runbook. The UI
# also requires a development build, emulator transport and the exact demo
# project above, so this cannot open a production build.
REACT_APP_MEMBERSHIP_TEST_JOURNEY_ENABLED=false
