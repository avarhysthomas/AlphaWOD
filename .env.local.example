# Local development overrides. Copy to .env.local, which is git-ignored.
#
# Points the app at the Firebase emulators instead of the live project, so
# local testing cannot read or write production data.
#
# Run the emulators alongside `npm start`:
#   firebase emulators:start --only auth,firestore,functions
#
# Leave this unset (or false) to run against the live project.
REACT_APP_USE_EMULATORS=true
