# Public Firebase web configuration for the Vercel production build.
# Copy these names into Vercel's Production environment only. Do not commit a
# populated .env.production file, and do not expose Functions/Stripe secrets as
# REACT_APP_* values: every REACT_APP_* value is bundled into the browser.
REACT_APP_FIREBASE_API_KEY=replace_with_production_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=alphawod-d1f2f.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=alphawod-d1f2f
REACT_APP_FIREBASE_STORAGE_BUCKET=replace_with_production_storage_bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=replace_with_production_sender_id
REACT_APP_FIREBASE_APP_ID=replace_with_production_app_id
REACT_APP_FIREBASE_APPCHECK_SITE_KEY=replace_with_production_app_check_site_key

# Customer-visible production kill switch. Keep false for preparation, armed
# deployments and rollback. Set true only after the backend intake gate is open
# and every release blocker has explicit approval. This value is public because
# Create React App bundles every REACT_APP_* variable into the browser.
REACT_APP_MEMBERSHIP_PURCHASE_ENABLED=false

# Both local-only switches must remain false in production.
REACT_APP_USE_EMULATORS=false
REACT_APP_MEMBERSHIP_TEST_JOURNEY_ENABLED=false
