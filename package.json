{
  "name": "wod-board",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "firebase": "^11.10.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "stripe:test": "npm run run:stripe-test-journey --prefix functions",
    "build": "react-scripts build",
    "build:production": "node scripts/verifyFrontendProductionEnv.js && react-scripts build",
    "lint": "eslint --max-warnings=0 --ext .ts,.tsx src",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "test:infrastructure": "node --test scripts/*.test.js",
    "verify:frontend-production-closed": "node scripts/verifyFrontendProductionEnv.js --expect-purchase-closed",
    "verify:frontend-production-open": "node scripts/verifyFrontendProductionEnv.js --expect-purchase-open",
    "verify:monitoring": "node scripts/verifyBillingMonitoring.js",
    "verify:published-legal": "npm run build --prefix functions && node --env-file-if-exists=functions/.env.alphawod-d1f2f scripts/verifyPublishedLegalDocuments.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
